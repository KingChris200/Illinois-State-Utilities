# Discord application (required)
DISCORD_TOKEN=
CLIENT_ID=

# ER:LC remote API
ERLC_SERVER_KEY=
ERLC_DRY_RUN=true
ERLC_MOCK_MODE=true

# Prefix-command access (comma-separated Discord IDs)
ERLC_COMMAND_ROLE_IDS=
ERLC_SENIOR_MOD_ROLE_IDS=
ERLC_COMMAND_CHANNEL_IDS=
ERLC_COMMAND_LOG_CHANNEL_ID=
ERLC_MODERATION_LOG_CHANNEL_ID=

# Central private reliability errors (falls back to command log channel)
BOT_ERROR_LOG_CHANNEL_ID=

# Session automation
ERLC_SESSION_CHANNEL_ID=1490731232311378010
ERLC_SESSION_AUTOMATION_ENABLED=false
SESSION_PLAYERCOUNT_INTERVAL_MS=60000

# Welcome system
WELCOME_CHANNEL_ID=1490733409037975654

# Community suggestions (optional; defaults to the command channel)
SUGGESTIONS_CHANNEL_ID=

# Staff Guide
STAFF_GUIDE_DOCUMENT_URL=https://docs.google.com/document/d/1-HhMjftqUdLhgdmoLhNSrNcpvkcwlo_p2JZ_4ri1C3o/edit?tab=t.3qivgdyxzvm9
STAFF_GUIDE_VERSION=1.0

# Automatic private data backups
DATA_BACKUPS_ENABLED=true
DATA_BACKUP_INTERVAL_MS=21600000
DATA_BACKUP_RETENTION=14

# ER:LC smart alerts (disabled until explicitly enabled)
ERLC_SMART_ALERTS_ENABLED=false
ERLC_SMART_ALERT_CHANNEL_ID=
ERLC_SMART_ALERT_ROLE_ID=
ERLC_SMART_ALERT_INTERVAL_MS=60000
ERLC_QUEUE_ALERT_THRESHOLD=5
ERLC_KILL_ALERT_THRESHOLD=5
ERLC_KILL_ALERT_WINDOW_SECONDS=120
ERLC_ALERT_COOLDOWN_SECONDS=300

# Private watchlist matching
WATCHLIST_ALERTS_ENABLED=false
WATCHLIST_ALERT_CHANNEL_ID=
WATCHLIST_ALERT_INTERVAL_MS=60000

# Optional durable branding overrides
ISRP_ASSET_BASE_URL=
ISP_BRAND_LOGO_URL=
